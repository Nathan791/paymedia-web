{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
      "module": "ESNext",
      "moduleResolution": "Bundler",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2022",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}