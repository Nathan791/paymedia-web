{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "lint": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },

    "db:generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/**"]
    },

    "db:migrate": {
      "cache": false
    },

    "clean": {
      "cache": false
    }
  }
}