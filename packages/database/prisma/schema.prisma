generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  ulid          String?   @unique @db.Char(26)
  username      String    @db.VarChar(50)
  email         String    @unique @db.VarChar(150)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  countryCode   String    @map("country_code") @db.Char(2)
  whatsappPhone String?   @map("whatsapp_phone") @db.VarChar(20)
  currency      String?   @default("XAF") @db.Char(3)
  isActive      Boolean?  @default(true) @map("is_active")
  isVerified    Boolean?  @default(false) @map("is_verified")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamp(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(6)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at")
  userProfileId Int?
  walletId      Int?      @unique @map("walletId")
  role          user_role @default(reader)
  wallet        Wallet?   @relation(fields: [walletId], references: [id])

  @@map("pm_user")
}

model Session {
  id        Int                @id @default(autoincrement())
  ulid      String             @unique @db.Char(26)
  userId    Int                @map("user_id")
  jti       String             @unique @db.Char(26)
  tokenType session_token_type @map("token_type")
  revokedAt DateTime?          @map("revoked_at") @db.Timestamp(6)
  expiresAt DateTime           @map("expires_at") @db.Timestamp(6)
  createdAt DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("pm_session")
}

model Wallet {
  id         Int       @id @default(autoincrement())
  ulid       String    @unique @db.Char(26)
  balance    Decimal?  @default(0.00) @db.Decimal(12, 2)
  currency   String?   @default("XAF") @db.Char(3)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")
  user       User?

  @@map("pm_wallet")
}

model ReadingProgress {
  id           Int       @id @default(autoincrement())
  ulid         String    @db.Char(26)
  userId       Int       @map("user_id")
  content_id   Int
  lastPosition String?   @map("last_position") @db.VarChar(100)
  progress     Float?    @default(0)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("pm_reading_progress")
}

model pm_admin_action {
  id          Int       @id @default(autoincrement())
  ulid        String    @unique @db.Char(26)
  user_id     Int
  action      String    @db.VarChar(100)
  target_type String?   @db.VarChar(50)
  target_id   Int?
  details     Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model pm_audit_log {
  id         Int       @id @default(autoincrement())
  ulid       String    @unique @db.Char(26)
  user_id    Int?
  action     String    @db.VarChar(100)
  entity     String?   @db.VarChar(50)
  entity_id  Int?
  metadata   Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model pm_category {
  id          Int       @id @default(autoincrement())
  ulid        String?   @unique @db.Char(26)
  name        String    @db.VarChar(50)
  slug        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now())
}

model pm_content {
  id                Int             @id @default(autoincrement())
  ulid              String?         @unique @db.Char(26)
  userId            Int
  categoryId        Int
  title             String          @db.VarChar(255)
  slug              String          @unique @db.VarChar(255)
  description       String
  mediaType         media_type
  isPremium         Boolean?        @default(true)
  price             Decimal?        @default(0) @db.Decimal(10, 2)
  freePreview       Int?
  status            content_status? @default(draft)
  publishedAt       DateTime?       @db.Timestamp(6)
  deletedAt         DateTime?       @db.Timestamp(6)
  createdAt         DateTime?       @default(now()) @db.Timestamp(6)
  updatedAt         DateTime?       @default(now())
  coverUrlEncrypted String?
  coverPublicId     String?
  coverFormat       String?
}

model pm_content_analytics {
  id         Int      @id @default(autoincrement())
  ulid       String   @unique @db.Char(26)
  content_id Int
  date       DateTime @db.Date
  views      Int?     @default(0)
  downloads  Int?     @default(0)
  purchases  Int?     @default(0)
  revenue    Decimal? @default(0) @db.Decimal(12, 2)

  @@unique([content_id, date])
}

model pm_content_file {
  id         Int               @id @default(autoincrement())
  ulid       String            @unique @db.Char(26)
  content_id Int
  file_type  content_file_type
  file_url   String
  file_size  BigInt?
  created_at DateTime?         @default(now()) @db.Timestamp(6)
}

model pm_content_moderation {
  id           Int                @id @default(autoincrement())
  ulid         String             @unique @db.Char(26)
  content_id   Int
  moderator_id Int?
  status       moderation_status? @default(PENDING)
  comment      String?
  moderated_at DateTime?          @db.Timestamp(6)
  created_at   DateTime?          @default(now()) @db.Timestamp(6)
}

model pm_content_review {
  id          Int             @id @default(autoincrement())
  ulid        String          @unique @db.Char(26)
  content_id  Int
  reviewer_id Int
  decision    review_decision
  comment     String?
  reviewed_at DateTime?       @default(now()) @db.Timestamp(6)
}

model pm_content_tag {
  ulid       String @unique @db.Char(26)
  content_id Int
  tag_id     Int

  @@id([content_id, tag_id])
}

model pm_download {
  id            Int       @id @default(autoincrement())
  ulid          String    @unique @db.Char(26)
  user_id       Int
  content_id    Int
  ip_address    String?   @db.VarChar(45)
  downloaded_at DateTime? @default(now()) @db.Timestamp(6)
}

model pm_notification {
  id         Int               @id @default(autoincrement())
  ulid       String            @unique @db.Char(26)
  user_id    Int
  type       notification_type
  title      String            @db.VarChar(150)
  message    String
  is_read    Boolean?          @default(false)
  created_at DateTime?         @default(now()) @db.Timestamp(6)
}

model pm_payout {
  id                Int            @id @default(autoincrement())
  ulid              String         @unique @db.Char(26)
  user_id           Int
  period_start      DateTime       @db.Date
  period_end        DateTime       @db.Date
  gross_amount      Decimal        @db.Decimal(12, 2)
  commission_amount Decimal        @db.Decimal(12, 2)
  net_amount        Decimal        @db.Decimal(12, 2)
  status            payout_status? @default(pending)
  payment_reference String?        @unique @db.VarChar(100)
  payment_method    String?        @db.VarChar(50)
  payment_provider  String?        @db.VarChar(50)
  paid_at           DateTime?      @db.Timestamp(6)
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  updated_at        DateTime?      @default(now())
}

model pm_purchase {
  id             Int              @id @default(autoincrement())
  ulid           String           @unique @db.Char(26)
  user_id        Int
  content_id     Int
  transaction_id Int?
  amount         Decimal          @db.Decimal(12, 2)
  status         purchase_status? @default(PENDING)
  purchased_at   DateTime?        @default(now()) @db.Timestamp(6)

  @@unique([user_id, content_id])
}

model pm_role {
  id         Int       @id @default(autoincrement())
  ulid       String    @unique @db.Char(26)
  code       String    @unique @db.VarChar(20)
  label      String    @db.VarChar(100)
  level      Int?      @default(0) @db.SmallInt
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model pm_tag {
  id         Int       @id @default(autoincrement())
  ulid       String    @unique @db.Char(26)
  name       String    @unique @db.VarChar(50)
  slug       String    @unique @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model pm_transaction {
  id                 Int                 @id @default(autoincrement())
  ulid               String              @unique @db.Char(26)
  wallet_id          Int
  content_id         Int?
  transaction_type   transaction_type
  amount             Decimal             @db.Decimal(12, 2)
  status             transaction_status? @default(pending)
  external_provider  String?             @db.VarChar(50)
  external_reference String?             @unique @db.VarChar(100)
  description        String?
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
}

model pm_user_preference {
  ulid        String    @unique @db.Char(26)
  user_id     Int
  category_id Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now())

  @@id([user_id, category_id])
}

model pm_user_profile {
  id         Int       @id @default(autoincrement())
  ulid       String    @unique @db.Char(26)
  avatar     String?
  bio        String?
  country    String?   @db.VarChar(100)
  birth_date DateTime? @db.Date
}

model pm_user_role {
  id          Int       @id @default(autoincrement())
  ulid        String    @unique @db.Char(26)
  user_id     Int
  role_id     Int
  assigned_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([user_id, role_id], map: "uk_user_role")
}

model pm_user_subscription {
  id             Int                  @id @default(autoincrement())
  ulid           String               @unique @db.Char(26)
  user_id        Int
  transaction_id Int?
  plan_name      String               @db.VarChar(100)
  duration_value Int?
  duration_unit  DurationUnit?
  status         subscription_status? @default(ACTIVE)
  started_at     DateTime?            @default(now()) @db.Timestamp(6)
  expires_at     DateTime?            @db.Timestamp(6)
  cancelled_at   DateTime?            @db.Timestamp(6)
}

enum user_role {
  reader
  editor
  admin
}

enum session_token_type {
  ACCESS
  REFRESH
}

enum MediaType {
  epub
  audio
  video
}

enum PubStatus {
  draft
  pending_review
  published
  rejected
  archived
}

enum TxType {
  deposit
  content_purchase
  subscription
  payout
  refund
  transfer
}

enum TxStatus {
  pending
  completed
  failed
  rejected
}

enum DurationUnit {
  hours
  days
  months
}

enum SubStatus {
  active
  expired
  cancelled
  suspended
}

enum PayoutStatus {
  pending
  paid
  failed
}

enum OtpChannel {
  sms
  whatsapp
  email
}

enum content_file_type {
  main
  preview
  cover
  thumbnail
  audio
  subtitle
  attachment
}

enum content_status {
  draft
  pending_review
  published
  rejected
  blocked
  archived
}

enum media_type {
  epub
  audio
  video
}

enum moderation_status {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum notification_type {
  PURCHASE
  DOWNLOAD
  PAYMENT
  CONTENT
  SECURITY
  SYSTEM
}

enum payout_status {
  pending
  paid
  failed
}

enum purchase_status {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum review_decision {
  approved
  rejected
  pending
}

enum subscription_status {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum transaction_status {
  pending
  completed
  failed
  cancelled
}

enum transaction_type {
  recharge
  paiement
  remboursement
}
