datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum user_role {
  reader
  editor
  admin
}

enum AgencyRole {
  agency_admin
  agency_editor
  agency_validator
}

enum WorkspaceType {
  independent
  agency
}

enum session_token_type {
  ACCESS
  REFRESH
}

enum MediaType {
  epub
  audio
  video
}

enum PubStatus {
  draft
  pending_review
  published
  rejected
  archived
}

enum TxType {
  deposit
  content_purchase
  subscription
  payout
  refund
  transfer
}

enum TxStatus {
  pending
  completed
  failed
  rejected
}

enum DurationUnit {
  hours
  days
  month
}

enum SubStatus {
  active
  expired
  cancelled
  suspended
}

enum PayoutStatus {
  pending
  paid
  failed
}

// ─── AUTH, ROLES & SESSIONS ───────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  ulid          String    @unique @db.Char(26)
  username      String    @db.VarChar(100)
  email         String?   @unique @db.VarChar(150)
  whatsappPhone String?   @map("whatsapp_phone") @db.VarChar(20)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  countryCode   String    @map("country_code") @db.Char(2)
  role          user_role @default(reader)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt     DateTime? @map("deleted_at")

  workspaceType WorkspaceType @default(independent) @map("workspace_type")
  agencyRole    AgencyRole?   @map("agency_role")

  agencyId Int?    @map("agency_id")
  agency   Agency? @relation("AgencyMembers", fields: [agencyId], references: [id], onDelete: SetNull)

  ownedAgency Agency? @relation("AgencyOwner")

  walletId Int?    @unique @map("wallet_id")
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  // Relations
  sessions                  Session[]
  preferences               UserPreference[]
  publications              Contenu[]                  @relation("EditorPublications")
  publicationReviews        PublicationReview[]        @relation("AdminReviews")
  subscriptions             UserSubscription[]
  purchases                 Purchase[]                 @relation("ReaderPurchases")
  editorPurchases           Purchase[]                 @relation("EditorPurchases")
  payouts                   Payout[]
  auditLogs                 AuditLog[]
  readingProgress           ReadingProgress[]
  contenus                  Contenu[]                  @relation("AdminReviewedPublications")
  userContentTypePreference UserContentTypePreference?
  likes                     Like[]
  notifications             Notification[]
  shareLinks                ShareLink[]
  reviews                   Review[] // <-- AJOUTÉ : Relation inverse pour les avis de l'utilisateur

  @@index([email])
  @@index([deletedAt])
  @@map("pm_user")
}

// ─── MODÈLE : AGENCY ──────────────────────────────────────────────────

model Agency {
  id          Int      @id @default(autoincrement())
  ulid        String   @unique @db.Char(36)
  name        String   @unique @db.VarChar(150)
  description String?  @db.Text
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  ownerId Int?  @unique @map("owner_id")
  owner   User? @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  members  User[]    @relation("AgencyMembers")
  contents Contenu[] @relation("AgencyPublications")

  @@map("pm_agencies")
}

model Session {
  id        Int                @id @default(autoincrement())
  ulid      String             @unique @db.Char(26)
  userId    Int                @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String             @unique @db.Char(26)
  tokenType session_token_type @map("token_type")
  revokedAt DateTime?          @map("revoked_at")
  expiresAt DateTime           @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("pm_session")
}

model Wallet {
  id        Int      @id @default(autoincrement())
  ulid      String   @unique @db.Char(26)
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  currency  String   @default("XAF") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user         User?
  transactions Transaction[]

  @@map("pm_wallet")
}

model Transaction {
  id                Int      @id @default(autoincrement())
  ulid              String   @unique @db.Char(36)
  walletId          Int      @map("wallet_id")
  wallet            Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  contentId         Int?     @map("content_id")
  content           Contenu? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  amount            Decimal  @db.Decimal(12, 2)
  type              TxType
  status            TxStatus @default(pending)
  externalProvider  String?  @map("external_provider") @db.VarChar(50)
  externalReference String?  @unique @map("external_reference") @db.VarChar(100)
  description       String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp()

  purchases Purchase[]

  @@index([walletId])
  @@index([contentId])
  @@index([status])
  @@index([createdAt])
  @@map("pm_transactions")
}

// ─── CATALOGUE & RECOMMANDATIONS ──────────────────────────────────────────────

model Category {
  id          Int    @id @default(autoincrement())
  ulid        String @unique @db.Char(26)
  name        String @db.VarChar(100)
  slug        String @unique @db.VarChar(100)
  description String @db.VarChar(100)

  publications Contenu[]

  @@map("pm_categories")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  userPreferences UserPreference[]
  publications    PublicationTag[]

  @@map("pm_tags")
}

model UserPreference {
  userUlid   String   @map("user_ulid") @db.Char(26)
  tagId      Int      @map("tag_id")
  categoryId Int      @map("category_id")
  score      Int      @default(1)
  isInitial  Boolean  @default(false) @map("is_initial")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userUlid], references: [ulid], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userUlid, tagId])
  @@map("pm_user_preferences")
}

model UserContentTypePreference {
  id       Int    @id @default(autoincrement())
  ulid     String @unique @db.Char(26)
  userUlid String @unique @map("user_ulid") @db.Char(26)
  user     User   @relation(fields: [userUlid], references: [ulid], onDelete: Cascade)

  preferredContentTypes String[] @map("preferred_content_types")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pm_user_content_type_preferences")
}

model Contenu {
  id          Int       @id @default(autoincrement())
  ulid        String    @unique @db.Char(26)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  mediaType   MediaType @map("media_type")

  fileUrl      String  @map("file_url") @db.VarChar(512)
  filePublicId String? @map("file_public_id") @db.VarChar(255)

  coverUrl          String? @map("cover_url") @db.VarChar(512)
  coverPublicId     String? @map("cover_public_id") @db.VarChar(255)
  thumbnailUrl      String? @map("thumbnail_url") @db.VarChar(512)
  thumbnailPublicId String? @map("thumbnail_public_id") @db.VarChar(255)

  userId Int? @map("editor_id")

  agencyId Int?    @map("agency_id")
  agency   Agency? @relation("AgencyPublications", fields: [agencyId], references: [id], onDelete: SetNull)

  categoryId Int? @map("category_id")

  isPremium Boolean @default(false) @map("is_premium")
  price     Decimal @default(0.00) @db.Decimal(10, 2)

  freeStartPage       Int? @default(1) @map("free_start_page")
  freeEndPage         Int? @map("free_end_page")
  freePreviewDuration Int? @map("free_preview_duration")

  status          PubStatus @default(draft)
  rejectionReason String?   @map("rejection_reason") @db.Text
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamp()
  reviewedById    Int?      @map("reviewed_by_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt DateTime? @map("deleted_at")

  author          User?               @relation("EditorPublications", fields: [userId], references: [id], onDelete: Restrict)
  reviewer        User?               @relation("AdminReviewedPublications", fields: [reviewedById], references: [id], onDelete: SetNull)
  category        Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            PublicationTag[]
  reviews         PublicationReview[]
  purchases       Purchase[]
  transactions    Transaction[]
  readingProgress ReadingProgress[]
  analytics       DailyAnalytics[]
  likes           Like[]
  shareLinks      ShareLink[]
  contentVersions ContentVersion[]
  userReviews     Review[] // <-- AJOUTÉ : Relation inverse pour les avis sur le contenu

  @@index([userId])
  @@index([agencyId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("pm_content")
}

model ContentVersion {
  id            Int      @id @default(autoincrement())
  ulid          String   @unique @db.Char(26)
  contentId     Int      @map("content_id")
  content       Contenu  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  versionNumber Int      @map("version_number")
  title         String   @db.VarChar(255)
  description   String   @db.Text
  fileUrl       String   @map("file_url") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([contentId])
  @@map("pm_content_versions")
}

model PublicationTag {
  publicationId Int @map("publication_id")
  tagId         Int @map("tag_id")

  publication Contenu @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  tag         Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([publicationId, tagId])
  @@map("pm_publication_tags")
}

model PublicationReview {
  id              Int       @id @default(autoincrement())
  publicationId   Int       @map("publication_id")
  adminId         Int?      @map("admin_id")
  decision        PubStatus
  rejectionReason String?   @map("rejection_reason") @db.Text
  reviewedAt      DateTime  @default(now()) @map("reviewed_at") @db.Timestamp()

  publication Contenu @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  admin       User?   @relation("AdminReviews", fields: [adminId], references: [id], onDelete: SetNull)

  @@map("pm_publication_reviews")
}

// ─── SUBSCRIPTIONS & COMMERCE ─────────────────────────────────────────────────

model SubscriptionPlan {
  id            Int          @id @default(autoincrement())
  ulid          String       @unique @db.Char(50)
  name          String       @db.VarChar(100)
  description   String?      @db.Text
  price         Decimal      @db.Decimal(10, 2)
  duration      DurationUnit @map("duration_type")
  durationValue Int          @map("duration_value")
  isActive      Boolean      @default(true) @map("is_active")

  subscriptions UserSubscription[]

  @@map("pm_subscription_plans")
}

model UserSubscription {
  id               Int       @id @default(autoincrement())
  ulid             String    @unique @db.Char(50)
  userId           Int       @map("user_id")
  planId           Int       @map("plan_id")
  startAt          DateTime  @map("start_at") @db.Timestamp()
  endsAt           DateTime  @map("ends_at") @db.Timestamp()
  status           SubStatus @default(active)
  paymentReference String    @default("WALLET_DEBIT") @map("payment_reference") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("pm_user_subscriptions")
}

model Purchase {
  id            Int    @id @default(autoincrement())
  ulid          String @unique @db.Char(36)
  userId        Int    @map("user_id")
  contentId     Int    @map("publication_id")
  editorId      Int    @map("editor_id")
  transactionId Int    @map("transaction_id")
  purchaseType  String @map("purchase_type") @db.VarChar(50)

  grossAmount        Decimal @map("gross_amount") @db.Decimal(10, 2)
  platformCommission Decimal @default(0.00) @map("platform_commission") @db.Decimal(10, 2)
  editorEarnings     Decimal @default(0.00) @map("editor_earnings") @db.Decimal(10, 2)

  unlockedAt DateTime  @default(now()) @map("unlocked_at") @db.Timestamp()
  revokedAt  DateTime? @map("revoked_at")

  user        User        @relation("ReaderPurchases", fields: [userId], references: [id], onDelete: Restrict)
  editor      User        @relation("EditorPurchases", fields: [editorId], references: [id], onDelete: Restrict)
  publication Contenu     @relation(fields: [contentId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  downloads Download[]

  @@unique([userId, contentId])
  @@map("pm_purchases")
}

model Download {
  id           Int      @id @default(autoincrement())
  ulid         String   @unique @db.Char(26)
  purchaseId   Int      @map("purchase_id")
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  downloadedAt DateTime @default(now()) @map("downloaded_at") @db.Timestamp()

  @@index([purchaseId])
  @@map("pm_downloads")
}

// ─── REVENUE DISTRIBUTION ─────────────────────────────────────────────────────

model Payout {
  id               Int          @id @default(autoincrement())
  ulid             String       @unique @db.Char(26)
  userId           Int          @map("user_id")
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  periodStart      DateTime     @map("period_start") @db.Date
  periodEnd        DateTime     @map("period_end") @db.Date
  grossAmount      Decimal      @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal      @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal      @map("net_amount") @db.Decimal(12, 2)
  status           PayoutStatus @default(pending)
  paidAt           DateTime?    @map("paid_at")

  @@index([userId])
  @@index([status])
  @@map("pm_payouts")
}

// ─── TRACKING, ENGAGEMENT & SÉCURITÉ ──────────────────────────────────────────

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String   @db.VarChar(100)
  targetTable String   @map("target_table") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.VarChar(100)
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("pm_audit_logs")
}

model ReadingProgress {
  id        Int      @id @default(autoincrement())
  ulid      String   @unique @default(cuid()) @db.Char(36)
  userId    Int      @map("user_id")
  contentId Int      @map("content_id")
  progress  Float    @default(0.0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp()

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Contenu @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("pm_reading_progress")
}

model DailyAnalytics {
  id            Int      @id @default(autoincrement())
  publicationId Int      @map("publication_id")
  date          DateTime @default(now()) @db.Date
  dailyViews    Int      @default(0) @map("daily_views")

  publication Contenu @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, date])
  @@map("pm_daily_analytics")
}

model Language {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  ulid      String   @unique @db.Char(26)
  name      String   @db.VarChar(64)
  isoCode   String   @unique @db.Char(2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pm_language")
}

model Lexicon {
  id          Int      @id @default(autoincrement())
  ulid        String   @unique @db.Char(26)
  reference   String   @unique
  description String?
  metadata    Json?
  translation Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pm_lexicon")
}

model Like {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  contentUlid String   @map("content_ulid") @db.Char(26)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Contenu @relation(fields: [contentUlid], references: [ulid], onDelete: Cascade)

  @@unique([userId, contentUlid])
  @@index([contentUlid])
  @@map("pm_likes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  ulid      String   @unique @db.Char(26)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("pm_notifications")
}

model ShareLink {
  id          Int      @id @default(autoincrement())
  ulid        String   @unique @db.Char(26)
  code        String   @unique @db.VarChar(50)
  contenuId   Int?
  content     Contenu? @relation(fields: [contenuId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicksCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([code])
  @@index([contenuId])
  @@index([userId])
}

model Review {
  id      Int     @id @default(autoincrement())
  ulid    String  @unique @db.Char(26)
  rating  Int // Note de 1 à 5
  comment String? @db.Text
  status  String  @default("approved") @db.VarChar(50) // 'approved', 'hidden', etc.

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contenuId Int     @map("contenu_id")
  content   Contenu @relation(fields: [contenuId], references: [id], onDelete: Cascade, map: "fk_review_contenu")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp()

  @@unique([userId, contenuId])
  @@index([contenuId])
  @@index([status])
  @@map("pm_reviews")
}
